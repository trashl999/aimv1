    colorNPC     = Color3.fromRGB(200, 160, 255),
    showHP       = true,
    showDistance = true,
}

local espObjects = {}

local function getAnchor(model)
    return model:FindFirstChild("Head")
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

local function getHealth(model)
    local hum = model and model:FindFirstChildOfClass("Humanoid")
    if not hum then return nil, nil end
    return hum.Health, hum.MaxHealth
end

local function isDead(model)
    local hp, max = getHealth(model)
    return hp and max and max > 0 and hp <= 0
end

local function newLabel(parent, size, y, color)
    local l = Instance.new("TextLabel")
    l.Size                   = UDim2.new(1, 0, 0, size + 2)
    l.Position               = UDim2.new(0, 0, 0, y)
    l.BackgroundTransparency = 1
    l.TextColor3             = color
    l.TextStrokeTransparency = 0.4
    l.Font                   = Enum.Font.SourceSansBold
    l.TextSize               = size
    l.TextXAlignment         = Enum.TextXAlignment.Center
    l.Parent                 = parent
    return l
end

local function createESP(model, color)
    if not model or not model.Parent or espObjects[model] then return end
    local anchor = getAnchor(model)
    if not anchor then return end

    local lh    = ESP_CFG.textSize + 4
    local lines = 1 + (ESP_CFG.showHP and 1 or 0) + (ESP_CFG.showDistance and 1 or 0)

    local bb = Instance.new("BillboardGui")
    bb.Size        = UDim2.new(0, 190, 0, lines * lh + 8)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.MaxDistance = ESP_CFG.maxDistance
    bb.Adornee     = anchor
    bb.Parent      = anchor

    local y = 2
    local nameLbl = newLabel(bb, ESP_CFG.textSize,     y, color or ESP_CFG.colorPlayer) ; y += lh
    local hpLbl   = newLabel(bb, ESP_CFG.textSize - 1, y, Color3.fromRGB(80, 220, 80))  ; y += lh
    local distLbl = newLabel(bb, ESP_CFG.textSize - 2, y, Color3.fromRGB(200, 200, 200))

    espObjects[model] = {
        gui     = bb,
        nameLbl = nameLbl,
        hpLbl   = hpLbl,
        distLbl = distLbl,
        anchor  = anchor,
        color   = color or ESP_CFG.colorPlayer,
    }
end

local function removeESP(model)
    local e = espObjects[model]
    if not e then return end
    pcall(function() e.gui:Destroy() end)
    espObjects[model] = nil
end

local function refreshESP()
    for model in pairs(espObjects) do removeESP(model) end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            createESP(p.Character, ESP_CFG.colorPlayer)
        end
    end

    local live = Workspace:FindFirstChild("Live")
    if live then
        for _, obj in ipairs(live:GetDescendants()) do
            if obj:IsA("Model") then
                createESP(obj, ESP_CFG.colorNPC)
            end
        end
    end
end

local function updateESP()
    if not ESP_CFG.enabled then
        for _, e in pairs(espObjects) do e.gui.Enabled = false end
        return
    end

    local cam = Workspace.CurrentCamera
    if not cam then return end
    local camPos = cam.CFrame.Position

    for model, e in pairs(espObjects) do
        if not model or not model.Parent then
            removeESP(model) ; continue
        end

        local anchor = getAnchor(model)
        if not anchor then e.gui.Enabled = false ; continue end

        if e.anchor ~= anchor then
            e.gui.Adornee = anchor
            e.anchor      = anchor
        end

        local root = model:FindFirstChild("HumanoidRootPart") or anchor
        local dist = (camPos - root.Position).Magnitude

        if isDead(model) or dist > ESP_CFG.maxDistance then
            e.gui.Enabled = false ; continue
        end

        e.gui.Enabled = true

        local p = Players:GetPlayerFromCharacter(model)
        e.nameLbl.Text       = p and p.DisplayName or model.Name
        e.nameLbl.TextColor3 = e.color

        if ESP_CFG.showHP then
            local hp, max = getHealth(model)
            if hp and max and max > 0 then
                local pct = hp / max
                e.hpLbl.Text       = math.floor(hp) .. " / " .. math.floor(max)
                e.hpLbl.TextColor3 = Color3.fromRGB(math.floor(255*(1-pct)), math.floor(255*pct), 60)
            else
                e.hpLbl.Text = "HP ?"
            end
        end
        e.hpLbl.Visible  = ESP_CFG.showHP

        if ESP_CFG.showDistance then
            e.distLbl.Text = math.floor(dist + 0.5) .. " studs"
        end
        e.distLbl.Visible = ESP_CFG.showDistance
    end
end

local function setupESPPlayer(p)
    if p == LP then return end
    p.CharacterAdded:Connect(function(char)
        task.wait(0.1)
        createESP(char, ESP_CFG.colorPlayer)
    end)
    p.CharacterRemoving:Connect(removeESP)
end

