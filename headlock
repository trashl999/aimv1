local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

local FOV_RADIUS = 999
local CAMERA_SMOOTHNESS = 0.15
local REQUIRE_LINE_OF_SIGHT = true
local LOCK_BIND_NAME = "LockOnCamera"

local holdingM2 = false
local currentTarget = nil

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LockOnFOV"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local fovCircle = Instance.new("Frame")
fovCircle.Name = "FOVCircle"
fovCircle.Size = UDim2.fromOffset(FOV_RADIUS * 2, FOV_RADIUS * 2)
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.BackgroundTransparency = 1
fovCircle.Parent = screenGui

local circleStroke = Instance.new("UIStroke")
circleStroke.Color = Color3.fromRGB(0, 255, 80)
circleStroke.Thickness = 2
circleStroke.Transparency = 0.05
circleStroke.Parent = fovCircle

local circleCorner = Instance.new("UICorner")
circleCorner.CornerRadius = UDim.new(1, 0)
circleCorner.Parent = fovCircle

local function updateFOVPosition()
	local viewportSize = camera.ViewportSize
	fovCircle.Position = UDim2.fromOffset(viewportSize.X / 2, viewportSize.Y / 2)
end

local function getHead(character)
	return character and character:FindFirstChild("Head")
end

local function isAlive(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid and humanoid.Health > 0
end

local function hasLineOfSight(targetHead)
	if not REQUIRE_LINE_OF_SIGHT then
		return true
	end

	local origin = camera.CFrame.Position
	local direction = targetHead.Position - origin

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {localPlayer.Character, targetHead.Parent}

	return workspace:Raycast(origin, direction, raycastParams) == nil
end

local function findBestTarget()
	local viewportSize = camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

	local bestTarget = nil
	local bestScreenDistance = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			local character = player.Character
			local head = getHead(character)

			if head and isAlive(character) then
				local screenPosition, visible = camera:WorldToViewportPoint(head.Position)

				if visible and screenPosition.Z > 0 then
					local targetScreenPosition = Vector2.new(screenPosition.X, screenPosition.Y)
					local distanceFromCenter = (targetScreenPosition - screenCenter).Magnitude

					if distanceFromCenter <= FOV_RADIUS and distanceFromCenter < bestScreenDistance and hasLineOfSight(head) then
						bestScreenDistance = distanceFromCenter
						bestTarget = head
					end
				end
			end
		end
	end

	return bestTarget
end

local function validTarget(targetHead)
	return targetHead and targetHead.Parent and isAlive(targetHead.Parent) and hasLineOfSight(targetHead)
end

local function stopCameraLock()
	RunService:UnbindFromRenderStep(LOCK_BIND_NAME)
end

local function startCameraLock()
	RunService:BindToRenderStep(LOCK_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if not holdingM2 then
			return
		end

		if not validTarget(currentTarget) then
			currentTarget = findBestTarget()
		end

		if currentTarget then
			local cameraPosition = camera.CFrame.Position
			local desiredCFrame = CFrame.lookAt(cameraPosition, currentTarget.Position)
			camera.CFrame = camera.CFrame:Lerp(desiredCFrame, CAMERA_SMOOTHNESS)
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		holdingM2 = true
		currentTarget = findBestTarget()
		startCameraLock()
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		holdingM2 = false
		currentTarget = nil
		stopCameraLock()
	end
end)

RunService.RenderStepped:Connect(function()
	updateFOVPosition()
end)

localPlayer.CharacterRemoving:Connect(function()
	currentTarget = nil
	holdingM2 = false
	stopCameraLock()
end)
