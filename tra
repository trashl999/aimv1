-- Variáveis Globais de Física e Estados
local flyBV
local CurrentState = "None"
local mobContainerCache = nil
local lastCacheUpdate = 0
local cachedNPC = {}
local lastNPCUpdate = 0
local lockedTarget = nil
local currentTarget = nil
local lastTargetUpdate = 0

-- ================= Limpeza e Setup ================= --
local function CleanupFloat()
    if flyBV then flyBV:Destroy() flyBV = nil end
end

-- Cria um campo de gravidade zero para o Farm e para o Fly
local function SetupFloat(root)
    CleanupFloat()
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
end

local function UpdateState()
    local newState = "None"
    
    if Options.FarmNearest or Options.FarmSelected then
        newState = "Farm"
    elseif Options.FlyEnabled then
        newState = "Fly"
    end
    
    if CurrentState ~= newState then
        CurrentState = newState
        CleanupFloat()
        
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if hum then hum.PlatformStand = false end
        
        if (newState == "Farm" or newState == "Fly") and root and hum then
            hum.PlatformStand = true
            SetupFloat(root)
        end
    end
end

-- ================= Lógica de Target ================= --
local function CleanName(name)
    return name:gsub("%[.-%]", ""):gsub("Lvl%.?%s*%d+", ""):gsub("Elite%s*", ""):gsub("Mega%s*", ""):gsub("Boss%s*", ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or name
end

local function IsValidMob(v)
    if not v or not v.Parent then return false end
    if Players:GetPlayerFromCharacter(v) then return false end
    local hum = v:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local rootPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("PrimaryPart")
    return rootPart ~= nil
end

local possibleFolders = {"NPCs", "Mobs", "Enemies", "Spawned", "Live", "Civilians", "NPCFolder", "MobFolder"}

local function GetMobContainer()
    if mobContainerCache and mobContainerCache.Parent and tick() - lastCacheUpdate < 8 then
        return mobContainerCache
    end
    for _, name in ipairs(possibleFolders) do
        local f = workspace:FindFirstChild(name)
        if f then mobContainerCache = f; lastCacheUpdate = tick(); return f end
    end
    for _, obj in ipairs(workspace:GetChildren()) do
        if (obj:IsA("Folder") or obj:IsA("Model")) then
            local lower = obj.Name:lower()
            if lower:find("npc") or lower:find("mob") or lower:find("enem") then
                mobContainerCache = obj; lastCacheUpdate = tick(); return obj
            end
        end
    end
    mobContainerCache = workspace; lastCacheUpdate = tick(); return workspace
end

local function GetAllMobModels(container)
    local results = {}
    for _, v in ipairs(container:GetChildren()) do
        if IsValidMob(v) then
            table.insert(results, v)
        elseif v:IsA("Folder") or v:IsA("Model") then
            for _, child in ipairs(v:GetChildren()) do
                if IsValidMob(child) then table.insert(results, child) end
            end
        end
    end
    return results
end

local function GetNPCList()
    if tick() - lastNPCUpdate < 10 then return cachedNPC end
    lastNPCUpdate = tick()
    local list, seen = {}, {}
    local container = GetMobContainer()
    for _, v in ipairs(GetAllMobModels(container)) do
        local hum = v:FindFirstChildOfClass("Humanoid")
        local rawName = (hum and hum.DisplayName ~= "" and hum.DisplayName) or v.Name
        local name = CleanName(rawName)
        if name ~= "" and not seen[name] then
            seen[name] = true; table.insert(list, name)
        end
    end
    table.sort(list)
    cachedNPC = list
    return list
end

local function GetTarget()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    if Options.TargetLockHP and lockedTarget and IsValidMob(lockedTarget) then
        return lockedTarget
    elseif Options.TargetLockHP and lockedTarget then
        lockedTarget = nil
    end

    local container = GetMobContainer()
    local closest, distMin = nil, math.huge

    for _, v in ipairs(GetAllMobModels(container)) do
        local tRoot = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("PrimaryPart")
        local hum = v:FindFirstChildOfClass("Humanoid")
        if not tRoot or not hum then continue end

        local rawName = (hum.DisplayName ~= "" and hum.DisplayName) or v.Name
        local name = CleanName(rawName)
        local dist = (root.Position - tRoot.Position).Magnitude

        local valid = (Options.FarmNearest and dist <= Options.FarmRange) or (Options.FarmSelected and Options.SelectedMobs[name])

        if valid and dist < distMin then
            distMin = dist
            closest = v
        end
    end

    lockedTarget = closest
    return closest
end

