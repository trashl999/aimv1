-- ================= Loop Principal (Heartbeat) ================= --
RunService.Heartbeat:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if CurrentState == "Farm" then
        if tick() - lastTargetUpdate >= 0.1 or not currentTarget or not IsValidMob(currentTarget) then
            lastTargetUpdate = tick()
            currentTarget = GetTarget()
        end

        if not currentTarget then 
            if flyBV then flyBV.Velocity = Vector3.zero end
            return 
        end

        local tRoot = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget:FindFirstChild("PrimaryPart")
        if not tRoot then return end
        
        -- Garante que o BodyVelocity exista para não cairmos
        if not flyBV or not flyBV.Parent then
            SetupFloat(root)
        end
        flyBV.Velocity = Vector3.zero

        -- CFrame Direto = Teleporte e Trava Instantânea Sem Atraso
        local dest = tRoot.CFrame * CFrame.new(Options.OffsetX, Options.OffsetY, Options.OffsetZ)
        local rot = CFrame.Angles(math.rad(Options.RotX), math.rad(Options.RotY), math.rad(Options.RotZ))
        root.CFrame = CFrame.lookAt(dest.Position, tRoot.Position) * rot

    elseif CurrentState == "Fly" and flyBV then
        if UserInputService:GetFocusedTextBox() then
            flyBV.Velocity = Vector3.zero
            return
        end
        
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.zero
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
        
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
        end
        
        flyBV.Velocity = moveDir * Options.FlySpeed
    end
end)

